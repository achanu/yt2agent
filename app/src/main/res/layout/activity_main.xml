<?xml version="1.0" encoding="utf-8"?>
<!-- The outer layout consumes the system-bar insets; the inner one carries the
     content padding — fitsSystemWindows on a padded view would replace its
     padding with the insets (which are 0 left/right). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="8dp"
            android:text="@string/app_name"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/cached_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/no_cached"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingTop="16dp"
            android:text="@string/no_cached_transcripts"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/config_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/config"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/config_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/config"
                android:src="@drawable/ic_expand"
                android:tint="?android:attr/colorControlNormal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/config_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/preprompt_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preprompt" />

            <EditText
                android:id="@+id/preprompt_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/preprompt_hint"
                android:inputType="textMultiLine"
                android:maxLength="500"
                android:maxLines="4"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/include_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/include_description" />

            <CheckBox
                android:id="@+id/remove_sponsors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_sponsors" />

            <CheckBox
                android:id="@+id/remove_selfpromo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remove_selfpromo" />

            <CheckBox
                android:id="@+id/share_as_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_as_file" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ttl_spinner_bg"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <Spinner
                        android:id="@+id/ttl_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/ttl_labels" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="@string/cache_ttl_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:paddingTop="8dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/yt_dlp_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/yt_dlp_version_loading"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
